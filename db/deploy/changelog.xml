<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     changelog.xml  -  the Liquibase list of install scripts
     Project     : Document Loading Agent (DLA) - CI/CD pipeline
     Environment : PRD (GHAPEXAPPS_ATP_PRD), run by the pipeline
     Purpose     : Every install script, in install order. On each
                   deploy Liquibase runs only the scripts that are
                   not yet in its ledger (table DATABASECHANGELOG in
                   WKSP_WKSPPRDWORKSPACE), plus any re-runnable
                   script whose file changed (runOnChange="true").
                   DLA_01 is run-once: never edit it; add a new
                   numbered script instead.
                   Utilities (reset, drop-all, re-read, inventory)
                   and read-only checks are not on this list; they
                   are never deployed.
     How to add a script: add one changeSet at the bottom, with a
                   new id, pointing at the new file.
     Runner      : runOracleScript sends each file through SQLcl
                   itself, so SET, PROMPT, SHOW ERRORS and @ work.
     Author      : Claude for Gary D. Hall, 11/24/2026
     ============================================================ -->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:n0="http://www.oracle.com/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Tables -->
    <changeSet id="dla-01-create-tables" author="garyhall" failOnError="true">
        <n0:runOracleScript objectName="DLA_01_CREATE_TABLES" ownerName="WKSP_WKSPPRDWORKSPACE" sourceType="FILE">
            <n0:source><![CDATA[db/tables/DLA_01_CREATE_TABLES.sql]]></n0:source>
        </n0:runOracleScript>
    </changeSet>

